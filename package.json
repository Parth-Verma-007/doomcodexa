{
  "name": "codexa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Real-time collaborative web IDE for C, C++, Java and Python",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm run dev -w @codexa/api",
    "dev:web": "npm run dev -w @codexa/web",
    "build": "npm run build -w @codexa/shared && npm run build -w @codexa/api && npm run build -w @codexa/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,css}\"",
    "test": "npm run test --workspaces --if-present",
    "db:local": "node scripts/local-mongo.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.4.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.4.3"
  }
}
