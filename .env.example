# ─── API ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Comma-separated list of origins allowed to call the API / open a socket.
CORS_ORIGINS=http://localhost:5173

# ─── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/codexa

# ─── Clerk ────────────────────────────────────────────────────────────────────
# https://dashboard.clerk.com → API keys
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Clerk Dashboard → Webhooks → signing secret (svix)
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Set to 1 to bypass Clerk entirely and run with a stub dev identity.
# NEVER set this in production — the API refuses to boot with it in NODE_ENV=production.
AUTH_DEV_BYPASS=0

# ─── Execution ────────────────────────────────────────────────────────────────
# The local engine runs code with no sandbox, so production must opt in.
EXEC_LOCAL_ALLOW_UNSANDBOXED=0

EXEC_MAX_CONCURRENCY=4
EXEC_RUN_TIMEOUT_MS=10000
EXEC_COMPILE_TIMEOUT_MS=20000
EXEC_MEMORY_MB=256
EXEC_MAX_OUTPUT_BYTES=1048576
EXEC_WORKSPACE_ROOT=

# ─── Admin ───────────────────────────────────────────────────────────────────
# Comma-separated emails allowed into /admin. Empty means nobody, and /admin
# 404s for everyone. Deliberately configuration rather than a database flag.
ADMIN_EMAILS=

# ─── Metrics ──────────────────────────────────────────────────────────────────
METRICS_USER=codexa
METRICS_PASSWORD=change-me

# ─── Web (apps/web/.env.local) ────────────────────────────────────────────────
VITE_API_URL=http://localhost:4000
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
