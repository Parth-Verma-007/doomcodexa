# ─── API ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Comma-separated list of origins allowed to call the API / open a socket.
CORS_ORIGINS=http://localhost:5173

# ─── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/codexa

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Nothing to configure. Codexa issues its own credentials: passwords are hashed
# with scrypt and a session is a random token whose SHA-256 lives in Mongo, so
# there is no signing key to set and no third-party service to sign up for.
# Accounts to develop against: node scripts/seed.mjs

# ─── Execution ────────────────────────────────────────────────────────────────
# The local engine runs code with no sandbox, so production must opt in.
EXEC_LOCAL_ALLOW_UNSANDBOXED=0

EXEC_MAX_CONCURRENCY=4
EXEC_RUN_TIMEOUT_MS=10000
EXEC_COMPILE_TIMEOUT_MS=20000
EXEC_MEMORY_MB=256
EXEC_MAX_OUTPUT_BYTES=1048576
EXEC_WORKSPACE_ROOT=

# ─── Admin ───────────────────────────────────────────────────────────────────
# Comma-separated emails allowed into /admin. Empty means nobody, and /admin
# 404s for everyone. Deliberately configuration rather than a database flag.
# Sign-up addresses are never verified, so list only accounts that already exist
# — an entry nobody has registered is an admin slot open to whoever claims it.
ADMIN_EMAILS=

# ─── Metrics ──────────────────────────────────────────────────────────────────
METRICS_USER=codexa
METRICS_PASSWORD=change-me

# ─── Web (apps/web/.env.local) ────────────────────────────────────────────────
VITE_API_URL=http://localhost:4000
